from machine import UART, PIN
from time import sleep

#Initialize UART
uart = UART(0, baudrate=9600, tx=PIN(12), rx=PIN(13))


while True: 
    #send data
    message = "TEST"
    uart.write(message)
    print("Sent:", message)
    #Allow time for the device to respond
    sleep(1)
    #read data
    if uart.any(): #Check if there is data to read

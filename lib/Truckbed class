from machine import Pin, PWM
import time

class Servo:
    def __init__(self, pin, freq=50, min_duty=1638, max_duty=8192):
        # Initialize PWM pin
        self.servo = PWM(Pin(pin))
        self.servo.freq(freq)
        # For SG90: 0.5ms–2.5ms pulse width → duty_u16 ~ 1638–8192
        self.min_duty = min_duty
        self.max_duty = max_duty

    def set_angle(self, angle):
        # Map angle (0-180) to duty cycle
        duty = int(self.min_duty + (angle / 180) * (self.max_duty - self.min_duty))
        self.servo.duty_u16(duty)

    def empty(self, start_angle, end_angle, delay=1):
        # Eksempel på en metode til at bevæge servoen mellem to vinkler
        self.set_angle(start_angle)
        time.sleep(delay)
        self.set_angle(end_angle)

truckbed_servo = Servo(pin=16)

truckbed_servo.empty(90,0)  
